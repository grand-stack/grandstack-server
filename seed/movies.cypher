e", "Comedy"], directors: ["Robert Zemeckis"], cast: [{name: "Tom Hanks", role: "Forrest Gump"}, {name: "Robin Wright", role: "Jenny Curran"}, {name: "Gary Sinise", role: "Lt. Dan Taylor"}, {name: "Sally Field", role: "Mrs. Gump"}]}] AS f
MERGE (m:Movie {title: f.title}) SET m.released = f.released, m.rating = f.rating, m.runtime = f.runtime
FOREACH (g IN f.genres | MERGE (ge:Genre {name: g}) MERGE (m)-[:IN_GENRE]->(ge))
FOREACH (d IN f.directors | MERGE (p:Person {name: d}) MERGE (p)-[:DIRECTED]->(m))
FOREACH (c IN f.cast | MERGE (p:Person {name: c.name}) MERGE (p)-[r:ACTED_IN]->(m) SET r.roles = [c.role]);
