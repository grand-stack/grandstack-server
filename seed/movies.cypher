// Movies seed. Statements end with a semicolon at end of line.
CREATE CONSTRAINT movie_title IF NOT EXISTS FOR (m:Movie) REQUIRE m.title IS UNIQUE;
CREATE CONSTRAINT person_name IF NOT EXISTS FOR (p:Person) REQUIRE p.name IS UNIQUE;
CREATE CONSTRAINT genre_name IF NOT EXISTS FOR (g:Genre) REQUIRE g.name IS UNIQUE;
MERGE (matrix:Movie {title: 'The Matrix'}) SET matrix.released = 1999, matrix.tagline = 'Welcome to the Real World';
MERGE (cloud:Movie {title: 'Cloud Atlas'}) SET cloud.released = 2012, cloud.tagline = 'Everything is connected';
MERGE (sleepless:Movie {title: 'Sleepless in Seattle'}) SET sleepless.released = 1993, sleepless.tagline = 'What if someone you never met was the someone you could never forget?';
MERGE (cast:Movie {title: 'Cast Away'}) SET cast.released = 2000, cast.tagline = 'At the edge of the world, his journey begins.';
MERGE (keanu:Person {name: 'Keanu Reeves'}) SET keanu.born = 1964;
MERGE (carrie:Person {name: 'Carrie-Anne Moss'}) SET carrie.born = 1967;
MERGE (lana:Person {name: 'Lana Wachowski'}) SET lana.born = 1965;
MERGE (hanks:Person {name: 'Tom Hanks'}) SET hanks.born = 1956;
MERGE (meg:Person {name: 'Meg Ryan'}) SET meg.born = 1961;
MERGE (nora:Person {name: 'Nora Ephron'}) SET nora.born = 1941;
MERGE (zemeckis:Person {name: 'Robert Zemeckis'}) SET zemeckis.born = 1952;
MERGE (scifi:Genre {name: 'Sci-Fi'});
MERGE (romance:Genre {name: 'Romance'});
MERGE (drama:Genre {name: 'Drama'});
MATCH (m:Movie {title: 'The Matrix'}), (p:Person {name: 'Keanu Reeves'}) MERGE (p)-[r:ACTED_IN]->(m) SET r.roles = ['Neo'];
MATCH (m:Movie {title: 'The Matrix'}), (p:Person {name: 'Carrie-Anne Moss'}) MERGE (p)-[r:ACTED_IN]->(m) SET r.roles = ['Trinity'];
MATCH (m:Movie {title: 'The Matrix'}), (p:Person {name: 'Lana Wachowski'}) MERGE (p)-[:DIRECTED]->(m);
MATCH (m:Movie {title: 'Cloud Atlas'}), (p:Person {name: 'Tom Hanks'}) MERGE (p)-[r:ACTED_IN]->(m) SET r.roles = ['Zachry', 'Dr. Henry Goose'];
MATCH (m:Movie {title: 'Cloud Atlas'}), (p:Person {name: 'Lana Wachowski'}) MERGE (p)-[:DIRECTED]->(m);
MATCH (m:Movie {title: 'Sleepless in Seattle'}), (p:Person {name: 'Tom Hanks'}) MERGE (p)-[r:ACTED_IN]->(m) SET r.roles = ['Sam Baldwin'];
MATCH (m:Movie {title: 'Sleepless in Seattle'}), (p:Person {name: 'Meg Ryan'}) MERGE (p)-[r:ACTED_IN]->(m) SET r.roles = ['Annie Reed'];
MATCH (m:Movie {title: 'Sleepless in Seattle'}), (p:Person {name: 'Nora Ephron'}) MERGE (p)-[:DIRECTED]->(m);
MATCH (m:Movie {title: 'Cast Away'}), (p:Person {name: 'Tom Hanks'}) MERGE (p)-[r:ACTED_IN]->(m) SET r.roles = ['Chuck Noland'];
MATCH (m:Movie {title: 'Cast Away'}), (p:Person {name: 'Robert Zemeckis'}) MERGE (p)-[:DIRECTED]->(m);
MATCH (m:Movie {title: 'The Matrix'}), (g:Genre {name: 'Sci-Fi'}) MERGE (m)-[:IN_GENRE]->(g);
MATCH (m:Movie {title: 'Cloud Atlas'}), (g:Genre {name: 'Sci-Fi'}) MERGE (m)-[:IN_GENRE]->(g);
MATCH (m:Movie {title: 'Sleepless in Seattle'}), (g:Genre {name: 'Romance'}) MERGE (m)-[:IN_GENRE]->(g);
MATCH (m:Movie {title: 'Cast Away'}), (g:Genre {name: 'Drama'}) MERGE (m)-[:IN_GENRE]->(g);
