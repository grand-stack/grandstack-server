{
  "name": "grandstack-server",
  "version": "0.7.1",
  "description": "GraphQL over Neo4j, configured entirely by environment variables and a mounted schema file",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint schema/schema.graphql && tsc --noEmit",
    "schema:check": "sh scripts/schema-check.sh",
    "docs:schema": "node scripts/generate-schema-docs.mjs",
    "docs:check": "node scripts/generate-schema-docs.mjs --check && node scripts/check-links.mjs"
  },
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@neo4j/graphql": "7.6.4",
    "graphql": "16.14.2",
    "graphql-yoga": "5.24.6",
    "neo4j-driver": "6.2.0"
  },
  "devDependencies": {
    "@graphql-eslint/eslint-plugin": "4.4.2",
    "@graphql-inspector/cli": "7.0.2",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
